      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT trade_date::timestamptz AS time, asset AS metric, correlation AS value FROM finance.rolling_corr_all('URTH', $window, ($__timeFrom())::date, ($__timeTo())::date, '$basis') WHERE asset IN ($assets) ORDER BY trade_date;",
          "refId": "A"
        }
      ],
