    {
      "id": 5,
      "title": "Matrice de corrélation — 15 actifs core",
      "type": "table",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT * FROM finance.corr_matrix_core(($__timeFrom())::date, ($__timeTo())::date, '$basis', $min_obs);",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "asset",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "displayMode": "color-background",
            "inspect": false
          },
          "decimals": 2,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "red",
                "value": -0.6
              },
              {
                "color": "orange",
                "value": -0.3
              },
              {
                "color": "gray",
                "value": -0.1
              },
              {
                "color": "light-blue",
                "value": 0.1
              },
              {
                "color": "blue",
                "value": 0.3
              },
              {
                "color": "dark-blue",
                "value": 0.6
              },
              {
                "color": "purple",
                "value": 0.8
              }
            ]
          },
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "transformations": [],
      "description": "Corrélation de Pearson des rendements logarithmiques, en EUR par défaut. Chaque cellule est calculée sur les dates communes aux deux actifs ; les paires sans assez d'observations restent vides. L'ordre des lignes/colonnes suit le clustering hiérarchique."
