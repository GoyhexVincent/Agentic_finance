        "iconColor": "orange",
        "name": "Ruptures de corrélation",
        "target": {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.break_date::timestamptz AS time, a.ticker || ' — rupture ' || b.method AS text, 'break' AS tags FROM finance.correlation_breaks b JOIN finance.assets a USING (asset_id) WHERE $__timeFilter(b.break_date) ORDER BY b.break_date;",
          "refId": "Anno"
        }
      }
    ]
