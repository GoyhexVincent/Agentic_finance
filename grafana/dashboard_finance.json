          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_date::timestamptz AS time, title AS text, category AS tags FROM finance.events WHERE $__timeFilter(event_date) ORDER BY event_date;",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRESQL}"
        },
