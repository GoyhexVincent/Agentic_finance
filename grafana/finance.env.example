# Environnement du service Grafana pour le Finance Tracker.
#
# Production : copier vers /etc/grafana/finance.env, puis
#   sudo chown root:grafana /etc/grafana/finance.env
#   sudo chmod 640 /etc/grafana/finance.env
#
# Le fichier est lu par le drop-in systemd créé par
# scripts/install_grafana_provisioning.sh. Il ne doit jamais être versionné.
#
# Les valeurs sont injectées dans grafana/provisioning/datasources/
# finance-postgres.yaml. Après un changement de mot de passe, incrémenter
# `version` dans ce YAML : Grafana ne réapplique un datasource provisionné
# que si ce numéro augmente.

GF_PG_HOST=localhost
GF_PG_PORT=5432
GF_PG_DATABASE=finance_db
GF_PG_USER=grafana
GF_PG_PASSWORD='change_me'

# Dossier contenant dashboard_finance.json.
GF_FINANCE_DASHBOARDS_PATH=/var/lib/grafana/dashboards
