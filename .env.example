# Copier vers .env puis adapter. Ce fichier est ignoré par Git.
# Il contient les variables des deux projets du dépôt.

# ── Finance Tracker — PostgreSQL ────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=finance_db
PGUSER=finance
PGPASSWORD=change_me

FINANCE_SCHEMA=finance
FINANCE_START_DATE=2015-01-01
FINANCE_MIN_OBS=60
FINANCE_HTTP_TIMEOUT=30
FINANCE_HTTP_RETRIES=3
FINANCE_HTTP_DELAY=0.4
FINANCE_MIN_IMPORT_INTERVAL_HOURS=18
FINANCE_CLUSTER_K=5
FINANCE_BREAK_WINDOW=126

# ── SMA92 Options Lab — Saxo SIM ────────────────────────────────────
# Jeton 24 h obtenu sur https://www.developer.saxo/openapi/token
# Le jeton du portail est uniquement valable en SIM.
SAXO_ACCESS_TOKEN=collez_votre_jeton_ici

# sim (par défaut) ou live. Le mode live exige un flux OAuth complet.
SAXO_ENV=sim

# Optionnel : mot de passe / clé d'application pour de futurs flux OAuth.
# SAXO_APP_KEY=
# SAXO_APP_SECRET=
