# Copier vers .env puis adapter.
# Production Raspberry Pi : base partagée marine_database, rôle finance.
PGHOST=localhost
PGPORT=5432
PGDATABASE=marine_database
PGUSER=finance
PGPASSWORD=change_me

FINANCE_SCHEMA=finance
